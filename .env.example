# =============================================
# .env — TicketFlash backend
# Copie este ficheiro para ".env" e preencha os valores.
# =============================================

# --- Servidor ---
PORT=5000

# URL onde o SEU FRONTEND corre (usado pelo CORS e nos emails)
FRONT_URL=http://localhost:3000
APP_URL=http://localhost:3000

# --- Base de dados (Supabase / Postgres) ---
# Onde encontrar estes valores no NOVO projeto Supabase:
#   1. Entre no projeto em https://supabase.com/dashboard
#   2. Vá a "Project Settings" (ícone de engrenagem) → "Database"
#   3. Em "Connection parameters" (ou "Connection string" → aba "URI"),
#      copie: Host, Port, Database name, User, Password
#
# Dica: use a ligação em modo "Session pooler" (porta 5432) para
# desenvolvimento normal, ou "Transaction pooler" (porta 6543) se
# estiver em ambiente serverless. Para uso simples do dia a dia,
# a ligação direta (Host que termina em ".supabase.co", porta 5432)
# funciona bem.
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=coloque_aqui_a_password_do_projeto
DB_DATABASE=postgres

# --- Autenticação ---
# Qualquer string longa e aleatória. Pode gerar uma com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=coloque_aqui_uma_string_secreta_longa_e_aleatoria

# --- Envio de emails (registo de utilizador, recuperação de senha) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=seu_email@gmail.com
EMAIL_PASS=sua_senha_de_app_do_gmail

# --- Criação automática do 1º administrador (opcional) ---
# Como /register agora exige um administrador já existente, uma base de
# dados nova não tem como criar o primeiro. Se preencher estas duas
# variáveis, o servidor cria esse administrador automaticamente na primeira
# vez que arrancar (só se ainda não existir NENHUM administrador).
# Depois de conseguir entrar, pode apagar/comentar estas linhas.
ADMIN_BOOTSTRAP_NOME=Administrador
ADMIN_BOOTSTRAP_EMAIL=admin@seudominio.com
ADMIN_BOOTSTRAP_PASSWORD=escolha_uma_password_forte
